# Local KDP automation server
KDP_SERVER_PORT=3001
KDP_API_URL=http://localhost:3001

# Session + cache directory (Playwright cookies, metadata JSON)
KDP_SESSION_DIR=.kdp-session

# Delay between every KDP page load and API call (ms) — avoids Amazon "Server Busy"
# Legacy alias: KDP_UPDATE_DELAY_MS
KDP_REQUEST_DELAY_MS=4000

# --- Access control (see docs/SECURITY-HARDENING.md) ---

# Interface to listen on. Loopback by default: this API can publish and delete
# books. Binding anything reachable requires KDP_API_TOKEN, or startup fails.
# KDP_BIND_HOST=127.0.0.1

# Shared secret required on every request when set. Generate with:
#   openssl rand -base64 32
# KDP_API_TOKEN=

# Browser origins allowed to call the API. Empty means cross-origin is refused.
# KDP_CORS_ORIGINS=http://localhost:5173

# Where one-shot approval tickets for publish/unpublish/delete/archive are stored.
# KDP_APPROVALS_FILE=.kdp-session/approvals.json

# Local KDP automation server
KDP_SERVER_PORT=3001
KDP_API_URL=http://localhost:3001

# Session + cache directory (Playwright storage_state, metadata JSON).
# Default: ~/.config/amazon-kdp-skill — deliberately outside the repo.
# Directory is forced to 0700 and the session file to 0600.
# KDP_SESSION_DIR=/home/you/.config/amazon-kdp-skill

# Delay before every KDP page load and API call, drawn uniformly at random from
# [min, max]. Jitter avoids a machine-perfect cadence and Amazon "Server Busy".
KDP_REQUEST_DELAY_MIN_MS=4000
KDP_REQUEST_DELAY_MAX_MS=10000

# Legacy: setting either of these pins BOTH ends to that value (fixed delay, no jitter).
# KDP_REQUEST_DELAY_MS=4000
# KDP_UPDATE_DELAY_MS=4000

# Browser. No Chromium is downloaded on install — an existing one is located at
# launch. Set this to override the search (see docs/RESOURCES.md).
# KDP_CHROMIUM_PATH=/nix/store/.../chrome-linux/chrome

# Headless. Defaults to true when there is no DISPLAY/WAYLAND_DISPLAY.
# KDP_HEADLESS=true
